# Pinned: the Railway VERSION variable is intentionally ignored so redeploys
# never pull a new major/minor implicitly. Bump here via PR.
FROM grafana/loki:3.7.9

# Copy the loki.yml configuration file to the container
COPY loki.yml /etc/loki/loki-config.yaml

# Command to run Loki
CMD ["-config.file=/etc/loki/loki-config.yaml"]
